<% layout('layouts/boilerplate')%>
 <div class="row mt-3">
        <div class="col-6 offset-3">
            <form method="POST" action="/signup" novalidate class="needs-validation">
<div class="mb-3">
  <label for="exampleFormControlInput1" class="form-label"><b>Username</b></label>
   <input type="text" name="username" placeholder="Username"  class="form-control" id="exampleFormControlInput1" required>
   <div class="invalid-feedback">enter username</div>
    </div>
    <div class="mb-3">
  <label for="exampleFormControlInput2" class="form-label"><b>Email</b></label>
   <input type="text" name="email" placeholder="email"  class="form-control" id="exampleFormControlInput2" required>
   <div class="invalid-feedback">enter email</div>
    </div>
    <div class="mb-3">
  <label for="exampleFormControlInput3" class="form-label"><b>Password</b></label>
   <input type="password" name="password" placeholder="Password"  class="form-control" id="exampleFormControlInput3" required>
   <div class="invalid-feedback">enter password</div>
    </div>
    <button type="submit" class="btn btn-dark add-btn">Sign Up</button>
            </form>
        </div>
 </div>