<% layout('layouts/boilerplate')%> 

  <div id="filters">
    <div id="filter">
      <div><i class="fa-solid fa-fire"></i></div>
      <p>Trending</p></div>
        <div id="filter">
       <div><i class="fa-solid fa-bed"></i></div>
      <p>Rooms</p> </div>
        <div id="filter">
      <div><i class="fa-solid fa-mountain-city"></i></div>
      <p>Iconic Cities</p></div>
        <div id="filter">
       <div><i class="fa-solid fa-mountain"></i></div>
      <p>Mountains</p></div>
       <div id="filter">
       <div><i class="fa-brands fa-fort-awesome"></i></div>
      <p>Castles</p></div>
       <div id="filter">
       <div><i class="fa-solid fa-seedling"></i></div>
      <p>Farms</p></div>
       <div id="filter">
       <div><i class="fa-solid fa-person-swimming"></i></div>
      <p>Amazing Pools</p></div>
       <div id="filter">
       <div><i class="fa-solid fa-campground"></i></div>
      <p>Campings</p>
    </div>  
    <div id="filter">
       <div><i class="fa-regular fa-snowflake"></i></div>
      <p>Snow</p>
    </div>  <div id="filter">
       <div><i class="fa-solid fa-sailboat"></i></div>
      <p>Boats</p>
    </div>  
      <div id="toggle-switch">
        <div class="form-check-reverse form-switch ">
  <input class="form-check-input toggle" type="checkbox" role="switch" id="switchSizeMd">
  <label class="form-check-label" >Display total after Tax</label>
</div>
      </div>
  </div>


    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 g-4 mb-3">
     <% for(let listing of alllistings) { %>
      <div class="col">
  <a href="listings/<%=listing.id %>" class="text-decoration-none">
      <div class="card listing-card">
      
   
  <img src="<%= listing.image.url %>" class="img-fluid rounded-3"  alt="https://unsplash.com/photos/amusement-park-arcade-with-ferris-wheel-ef_GXG3d7bI"  >
  <div class="card-img-overlay">
  </div><div class="card-body card-prop">
    <p class="card-text"><b><%= listing.title %>.</b>   <br>  
       <b> <%= listing.location %>,<%= listing.country%><br> 
         &#8377;<%= listing.price.toLocaleString("en-IN") %> </b>
      <i class="tax-info">+18% GST</i>
      </p>
 
  </div>
</div>
 </a>
      </div>
  
        <% } %>
    </div>
    
<script>
  let button = document.getElementsByClassName('toggle')[0];
  button.addEventListener('click', function() {
 let taxinfo = document.getElementsByClassName('tax-info');
 for (info of taxinfo) {
  if (info.style.display !== "inline") {
    info.style.display = "inline";
  } else {
    info.style.display = "none";
  }
}});
</script>
