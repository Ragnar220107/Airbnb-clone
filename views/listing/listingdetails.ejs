<% layout('layouts/boilerplate')%>
<script>
    const mapToken = '<%= process.env.MAP_TOKEN %>';
     const coordinates =<%- JSON.stringify(listingdata.geometry.coordinates) %>;
     const listingdata = <%- JSON.stringify(listingdata) %>;
</script>
<div class="row mt-3">  
    <div class="col-8 offset-2">
        <div class="card listing-card" >
            <img src="<%= listingdata.image.url %>" class="card-img-top detail-img" alt="listing image" >
            <div class="card-body">
                <p class="card-text">owned by <i><b><%= listingdata.owner.username %></b></i></p>
                <h5 class="card-title"><%= listingdata.title %></h5>
                <p class="card-text"><%= listingdata.description %><br>
                    Price: &#8377; <%= listingdata.price.toLocaleString("en-IN") %><br>
                    Location: <%= listingdata.location %><br>
                    Country: <%= listingdata.country %><br>
                </p>
                
                <% if(currUser && currUser._id.equals(listingdata.owner._id)){ %>
                    <div class="btn d-flex gap-2">
                        <a href="/listings/<%= listingdata.id %>/edit" class="btn btn-dark edit-btn">Edit</a>
                        <form method="POST" action="/listings/<%= listingdata.id %>?_method=DELETE">
                            <button type="submit" class="btn btn-dark">Delete Listing</button>
                        </form>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<div class="col-8 offset-2 mt-4">
    <% if(currUser) { %>
        <hr>
          <h4>Leave a Rating:</h4>
        <form action="/listings/<%= listingdata.id %>/reviews" method="POST" novalidate class="needs-validation">
            <div >
           <fieldset class="starability-slot">
  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>
</div>
            <div class="mb-3">
                <label for="comment" class="form-label">Comments</label>
                <textarea id="comment" name="review[comment]" rows="4" class="form-control" style="max-width: 100%;" required></textarea>
                <div class="invalid-feedback">enter review</div>
            </div>
            <button class="btn btn-outline-dark">Submit</button>
        </form>
    <% } %>
</div>


<% if (listingdata.review.length === 0) { %>
    <hr>
    <p class="text-center">No reviews yet.</p>
<% } else { %>
    <hr>
    <h4>All Reviews</h4>
    <div class="row">
        <% for (let review of listingdata.review) { %>
            <div class="col-md-5 ms-md-3 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title"><%= review.author.username %></h5>
                        <p class="starability-result" data-rating="<%= review.rating %>">
                            Rated: <%= review.rating %> stars
                        </p>
                        <p class="card-text"><%= review.comment %></p>
                    </div>
                </div>
            </div>
        <% } %>
    </div>
<% } %>
   <div class="col-8 offset-2 mt-4">
    <hr>
        <h3>You'll be here</h3>
        <div id="map"></div>
    </div>
<script src="/js/map.js"></script>

<br>