<% layout('layouts/boilerplate')%>
<body>
    <div class="row mt-3">
    <div class=" col-8 offset-2">
    <h2>Create New Listing</h2>
<form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
    <div class="mb-3">
  <label for="exampleFormControlInput1" class="form-label"><b>Title</b></label>
   <input type="text" name="listing[title]" placeholder="Title"  class="form-control" id="exampleFormControlInput1" required>
   <div class="invalid-feedback">enter title</div>
    </div>
    <div class="mb-3">
  <label for="exampleFormControlTextarea1" class="form-label"><b>Description</b></label>
  <textarea class="form-control" id="exampleFormControlTextarea1" rows="4" cols="50" type="text" name="listing[description]" placeholder="Description" required></textarea>
  <div class="invalid-feedback">enter description</div>
</div>
<div class="mb-3">
  <label for="exampleFormControlInput2" class="form-label"><b>Price</b></label>
  <input  class="form-control" id="exampleFormControlInput2"   name="listing[price]" placeholder="Price" >
  <div class="invalid-feedback">enter price</div>
</div>
<div class="row">
  
    <div class="mb-3 col-md-4">
  <label for="exampleFormControlInput3" class="form-label"><b>Location</b></label>
  <input  class="form-control" id="exampleFormControlInput3" type="text" name="listing[location]" placeholder="Location" required>
  <div class="invalid-feedback">enter location</div>
</div>
<div class="mb-3 col-md-8">
  <label for="exampleFormControlInput4" class="form-label"><b>Country</b></label>
  <input class="form-control" id="exampleFormControlInput4" type="text" name="listing[country]" placeholder="Country" required>
  <div class="invalid-feedback">enter country</div>
</div>
</div>

<div class="mb-3">
  <label for="exampleFormControlInput5" class="form-label"><b>Upload Image</b></label>
  <input class="form-control" id="exampleFormControlInput5" type="file" name="listing[image]" placeholder="Image URL" required >
  <div class="invalid-feedback">Upload Image</div>
</div>

    <button type="submit" class="btn btn-dark add-btn">Create Listing</button>
    <br><br>    
</form>
</div>
</div>
</body>
